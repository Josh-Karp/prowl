{
  "name": "prowl",
  "version": "0.2.0",
  "description": "Local AI browser testing CLI powered by Ollama and Playwright MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josh-Karp/prowl.git"
  },
  "homepage": "https://github.com/Josh-Karp/prowl#readme",
  "bugs": {
    "url": "https://github.com/Josh-Karp/prowl/issues"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#tests/*.js": "./tests/*.ts",
    "#package.json": "./package.json"
  },
  "bin": {
    "prowl": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/prepare.mjs"
  ],
  "scripts": {
    "test": "tsx --conditions=development --test tests/*.test.ts",
    "test:package": "tsx --conditions=development --test tests/package.integration.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "demo": "tsx --conditions=development demo/server.ts",
    "dev": "tsx --conditions=development src/index.ts",
    "typecheck": "tsc --noEmit",
    "prowl": "tsx --conditions=development src/cli.ts",
    "clean": "rm -rf logs .playwright-mcp dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prepare": "node scripts/prepare.mjs",
    "test:context": "tsx --conditions=development --test tests/context.integration.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,html,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "commander": "15.0.0",
    "dotenv": "^18.0.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "latest",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsx": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
