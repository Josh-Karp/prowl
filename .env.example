# Copy this file: cp .env.example .env

OLLAMA_MODEL=gemma4:12b # Ollama model to use when --model is not provided.
OLLAMA_BASE_URL=http://localhost:11434 # Ollama base URL to use when --base-url is not provided (without /api/chat).
OLLAMA_NUM_CTX=16384 # Model context window in tokens. Keep enough room for browser tools and history.
OLLAMA_TIMEOUT_MS=120000 # Maximum time for one model response, including its body (milliseconds).

# Maximum agent iterations (positive integer; defaults to 30).
MAX_ITERATIONS=30

# Base log filename; each run adds a timestamp and unique ID before the extension.
# --log-file overrides this; --verbose also prints details.
LOG_FILE=logs/prowl.log

# Automatic scoped browser observations and deterministic history management.
PROWL_CONTEXT_MODE=auto
# Optional byte budget; defaults to twice OLLAMA_NUM_CTX.
# PROWL_HISTORY_BYTES=32768
